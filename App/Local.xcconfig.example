// Copy to App/Local.xcconfig (ignored by Git) and enter the team ID of your Apple Development certificate:
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
// The value after OU= is the team ID.
DEVELOPMENT_TEAM = CHANGEME

// Local update tests only: test feed and public test key; $() keeps the // in the URL from starting a comment.
// ZACK_FEED_URL = http:/$()/127.0.0.1:8000/appcast.xml
// ZACK_ED_PUBLIC_KEY = CHANGEME
