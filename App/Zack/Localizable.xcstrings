    "Das geladene Modell weicht von der geprüften Fassung ab und wurde gelöscht." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das geladene Modell weicht von der geprüften Fassung ab und wurde gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The downloaded model differs from the checked version and was deleted."
          }
        }
      }
    },
    "Die Kopie weicht von der geprüften Fassung ab. Bitte das Modell laden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie weicht von der geprüften Fassung ab. Bitte das Modell laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The copy differs from the checked version. Please download the model."
          }
        }
      }
    },
    "Die Suche läuft nur nach Zustimmung, einmal am Tag. Feed und Downloads kommen von GitHub (GitHub Inc., USA); jede Anfrage überträgt die IP-Adresse, die bevorzugten Sprachen und den User-Agent ‚Zack/<Version> Sparkle/<Version>‘." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche läuft nur nach Zustimmung, einmal am Tag. Feed und Downloads kommen von GitHub (GitHub Inc., USA); jede Anfrage überträgt die IP-Adresse, die bevorzugten Sprachen und den User-Agent ‚Zack/<Version> Sparkle/<Version>‘."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks run only with your consent, once a day. The feed and downloads come from GitHub (GitHub Inc., USA); each request sends the IP address, the preferred languages and the user agent “Zack/<Version> Sparkle/<Version>”."
          }
        }
      }
    },
    "Eine Kopie aus dem Messstand liegt vor und wird verschoben, ohne Download." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kopie aus dem Messstand liegt vor und wird verschoben, ohne Download."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A copy from the benchmark setup was found and will be moved without a download."
          }
        }
      }
    },
