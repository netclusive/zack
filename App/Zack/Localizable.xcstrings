        }
      }
    },
    "Größe %@. Quelle: Hugging Face (USA); übertragen werden IP-Adresse, App- und macOS-Version und bevorzugte Sprachen. Lizenz: CC BY 4.0." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größe %@. Quelle: Hugging Face (USA); übertragen werden IP-Adresse, App- und macOS-Version und bevorzugte Sprachen. Lizenz: CC BY 4.0."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Size: %@. Source: Hugging Face (USA); the request sends the IP address, the app and macOS version and the preferred languages. License: CC BY 4.0."
          }
        }
      }
    },
    "Hält Spotify und YouTube in Chrome während eines Diktats an und setzt sie danach fort." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält Spotify und YouTube in Chrome während eines Diktats an und setzt sie danach fort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauses Spotify and YouTube in Chrome during a dictation and resumes them afterwards."
          }
        }
      }
    },
    "Hält das Mikrofon nach einem Diktat offen, damit der Anfang nicht fehlt. Solange es offen ist, zeigt macOS den orangen Punkt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält das Mikrofon nach einem Diktat offen, damit der Anfang nicht fehlt. Solange es offen ist, zeigt macOS den orangen Punkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the microphone open after a dictation so the start isn’t cut off. While it’s open, macOS shows the orange dot."
          }
        }
      }
    },
