    "In diesen Apps diktiert Zack im Code-Modus: Dateinamen und Schreibweisen werden zu Code, kurze Befehle bekommen keinen Punkt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesen Apps diktiert Zack im Code-Modus: Dateinamen und Schreibweisen werden zu Code, kurze Befehle bekommen keinen Punkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In these apps, Zack dictates in code mode: file names and case commands become code, and short commands get no period."
