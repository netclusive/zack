    "Enthält ein Diktat eine Selbstkorrektur wie ‚Montag, nein, Dienstag‘, glättet Apples Modell den Satz auf diesem Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält ein Diktat eine Selbstkorrektur wie ‚Montag, nein, Dienstag‘, glättet Apples Modell den Satz auf diesem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a self-correction such as “Monday, no, Tuesday” in a dictation, Apple’s model cleans up the sentence on this Mac."
          }
        }
      }
    },
